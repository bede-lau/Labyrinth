{
  "name": "labyrinth-renderer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Labyrinth frontend ('renderer' process). Must never import from main/.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "tokens": "node --experimental-strip-types --no-warnings scripts/gen-tokens-css.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "plotly.js-dist-min": "4.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "ajv": "8.20.0",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
