{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import os,runpy; runpy.run_path(os.path.join(os.environ.get('CLAUDE_PROJECT_DIR') or os.getcwd(),'scripts','hooks','post_edit_boundary.py'),run_name='__main__')\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import os,runpy; runpy.run_path(os.path.join(os.environ.get('CLAUDE_PROJECT_DIR') or os.getcwd(),'scripts','hooks','stop_launcher.py'),run_name='__main__')\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
