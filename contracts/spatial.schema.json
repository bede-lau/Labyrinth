{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labyrinth.local/contracts/spatial.schema.json",
  "title": "Inspect spatial parallelism: GENE-X on separate Dommaschk geometry (replay)",
  "type": "object",
  "required": ["schemaVersion", "geometry", "code", "nPlanes", "ranks", "exchanges", "fieldSolve", "runs", "timing", "independenceNote", "fixtures", "provenance"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "geometry": { "const": "Dommaschk" },
    "code": { "const": "GENE-X" },
    "nPlanes": { "type": "integer" },
    "ranks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rank", "device", "planes"],
        "additionalProperties": false,
        "properties": {
          "rank": { "type": "integer" },
          "device": { "type": "string" },
          "planes": { "type": "array", "items": { "type": "integer" } }
        }
      }
    },
    "exchanges": {
      "description": "MPI halo exchanges between neighbouring toroidal planes owned by different ranks (periodic).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fromRank", "toRank", "planes"],
        "additionalProperties": false,
        "properties": {
          "fromRank": { "type": "integer" },
          "toRank": { "type": "integer" },
          "planes": { "type": "array", "items": { "type": "integer" } }
        }
      }
    },
    "fieldSolve": { "type": "object", "required": ["device"], "properties": { "device": { "const": "CPU" } } },
    "runs": {
      "type": "object",
      "required": ["controlled", "passedReference"],
      "additionalProperties": false,
      "properties": { "controlled": { "type": "integer" }, "passedReference": { "type": "integer" } }
    },
    "timing": {
      "type": "object",
      "required": ["cpuMeanS", "gpuMeanS", "speedup", "speedupRecomputed"],
      "additionalProperties": false,
      "properties": {
        "cpuMeanS": { "type": "number" },
        "gpuMeanS": { "type": "number" },
        "speedup": { "type": "number" },
        "speedupRecomputed": { "type": "number" }
      }
    },
    "independenceNote": { "type": "string" },
    "fixtures": {
      "description": "PRD numbers this artifact reports (D-023): the speedup is an arithmetic re-check of PRD-reported means; the controlled-run tally and the means themselves cannot be recomputed here (matches null).",
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/fixtureCheck" }
    },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  }
}
