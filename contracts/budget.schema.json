{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labyrinth.local/contracts/budget.schema.json",
  "title": "Budget and presentation figures",
  "type": "object",
  "required": ["schemaVersion", "ceilingUsd", "postedUsd", "plannedUsd", "remainingAfterPlanUsd", "scenarios", "fixtures", "guardPlan"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "ceilingUsd": { "type": "number" },
    "postedUsd": { "type": "number", "description": "Provisionally posted earlier (PRD)." },
    "plannedUsd": { "type": "number" },
    "remainingAfterPlanUsd": { "type": "number" },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "headline", "inputs", "derivation", "interpretation", "provenance"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "headline": { "type": "string" },
          "inputs": { "type": "object", "additionalProperties": { "type": ["number", "string"] } },
          "derivation": { "type": "string", "description": "Human-readable arithmetic, recomputed from inputs." },
          "interpretation": { "type": "string" },
          "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
        }
      }
    },
    "fixtures": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/fixtureCheck" } },
    "guardPlan": {
      "description": "The live budget guard's plan (D-015, D-023), computed by main/ calling live_gx/budget_guard.py itself: posted amount + two rehearsals + one live slot, each priced with setup, idle and storage/egress allowances. Differs from the PRD's GPU-only plannedUsd; show both, labelled.",
      "type": "object",
      "required": ["slotEstimateUsd", "rehearsalEstimateUsd", "slotHardTimeoutS", "rehearsalHardTimeoutS", "plannedTotalUsd", "assumptions"],
      "additionalProperties": false,
      "properties": {
        "slotEstimateUsd": { "type": "number", "description": "Guard estimate for one live slot, rounded up to the cent." },
        "rehearsalEstimateUsd": { "type": "number", "description": "Guard estimate for one rehearsal allocation (two launches), rounded up to the cent." },
        "slotHardTimeoutS": { "type": "integer", "description": "Hard timeout the guard sets for the live slot at its place in the plan." },
        "rehearsalHardTimeoutS": { "type": "integer", "description": "Hard timeout the guard sets for a rehearsal allocation (the lower of the two in the plan)." },
        "plannedTotalUsd": { "type": "number", "description": "postedUsd + 2 x rehearsalEstimateUsd + slotEstimateUsd." },
        "assumptions": { "type": "string", "description": "The guard's allowances (not PRD numbers) and whether every step fits the ceiling." }
      }
    }
  }
}
