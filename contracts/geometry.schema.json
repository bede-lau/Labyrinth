{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labyrinth.local/contracts/geometry.schema.json",
  "title": "Locate the tubes: W7-X high-mirror geometry and sampled field lines",
  "type": "object",
  "required": ["schemaVersion", "equilibrium", "surface", "tubes", "validation", "provenance"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "equilibrium": {
      "type": "object",
      "required": ["name", "configuration", "nfp", "source"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "configuration": { "type": "string" },
        "nfp": { "type": "integer" },
        "source": { "$ref": "common.schema.json#/$defs/source" }
      }
    },
    "surface": {
      "description": "Gray context mesh of the sampled flux surface (normalized radius rho, s = rho^2). Unsampled regions stay gray.",
      "type": "object",
      "required": ["rho", "s", "iota", "nTheta", "nPhi", "positions"],
      "additionalProperties": false,
      "properties": {
        "rho": { "type": "number" },
        "s": { "type": "number" },
        "iota": { "type": "number" },
        "nTheta": { "type": "integer", "minimum": 8 },
        "nPhi": { "type": "integer", "minimum": 8 },
        "positions": {
          "description": "Flat [x0,y0,z0,x1,...] in metres, row-major over (phi, theta); length 3*nTheta*nPhi. Periodic in both indices with NO duplicated seam row/column: consumers must wrap indices (phi nPhi-1 -> 0, theta nTheta-1 -> 0) when triangulating.",
          "type": "array",
          "items": { "type": "number" }
        },
        "boundary": {
          "description": "Plasma boundary (s=1) cross-sections keyed by tube id, for the 2D inset.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["R", "Z"],
            "additionalProperties": false,
            "properties": { "R": { "type": "array", "items": { "type": "number" } }, "Z": { "type": "array", "items": { "type": "number" } } }
          }
        }
      }
    },
    "tubes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "label", "zetaCenterDeg", "alpha", "nSamples", "samples", "crossSection", "bmagRange"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["bean", "triangular"] },
          "label": { "type": "string" },
          "zetaCenterDeg": { "type": "number" },
          "alpha": { "type": "number" },
          "nSamples": { "type": "integer" },
          "bmagRange": { "$ref": "common.schema.json#/$defs/window" },
          "samples": {
            "description": "Ordered along the field line from start to end.",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["thetaStar", "zeta", "bmag", "R", "Z", "x", "y", "z"],
              "additionalProperties": false,
              "properties": {
                "thetaStar": { "type": "number", "description": "Straight-field-line poloidal angle (stella zed), rad." },
                "zeta": { "type": "number", "description": "Toroidal angle, rad (VMEC phi)." },
                "bmag": { "type": "number", "description": "|B| / B_ref (stella normalisation)." },
                "R": { "type": "number" },
                "Z": { "type": "number" },
                "x": { "type": "number" },
                "y": { "type": "number" },
                "z": { "type": "number" }
              }
            }
          },
          "crossSection": {
            "description": "The sampled surface at the tube's central toroidal angle.",
            "type": "object",
            "required": ["zetaDeg", "R", "Z"],
            "additionalProperties": false,
            "properties": {
              "zetaDeg": { "type": "number" },
              "R": { "type": "array", "items": { "type": "number" } },
              "Z": { "type": "array", "items": { "type": "number" } }
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["stellaReference", "float64Reference", "acceptance129"],
      "additionalProperties": false,
      "properties": {
        "stellaReference": {
          "description": "Our VMEC field-line tracer vs stella's saved EXPECTED_OUTPUT geometry (rho=0.7, 25 samples).",
          "type": "object",
          "required": ["samplesCompared", "printedSignificantFigures", "maxAbsError", "maxRelError", "allWithinPrintedPrecision", "source"],
          "additionalProperties": false,
          "properties": {
            "samplesCompared": { "type": "integer" },
            "printedSignificantFigures": { "type": "integer" },
            "maxAbsError": { "type": "number" },
            "maxRelError": { "type": "number" },
            "allWithinPrintedPrecision": { "type": "boolean" },
            "source": { "$ref": "common.schema.json#/$defs/source" }
          }
        },
        "float64Reference": {
          "description": "Our tracer's bmag vs stella's float64 bmag(zed, alpha) in EXPECTED_OUTPUT.vmec_geometry.out.nc (same rho=0.7 run, 25 samples). tolerance is absolute on bmag = |B|/B_ref; allWithinTolerance is true only when every sample's bmag error, and the zed grid offset, are within it (decided on the unrounded errors). maxAbsError/maxRelError are upper bounds: the computed error x 1.2, rounded UP to 1 significant figure (errors this small differ in their later digits between CPUs and BLAS kernels, and the artifact must rebuild byte-identically). A float64 failure fails the tracer validation: provenance.verification.outcome is then 'failed'.",
          "type": "object",
          "required": ["samplesCompared", "tolerance", "maxAbsError", "maxRelError", "allWithinTolerance", "source"],
          "additionalProperties": false,
          "properties": {
            "samplesCompared": { "type": "integer" },
            "tolerance": { "type": "number" },
            "maxAbsError": { "type": "number" },
            "maxRelError": { "type": "number" },
            "allWithinTolerance": { "type": "boolean" },
            "source": { "$ref": "common.schema.json#/$defs/source" }
          }
        },
        "acceptance129": {
          "description": "PRD acceptance: bean |B| agrees with all 129 saved stella samples at rho=0.8. Always blocked until those samples exist (D-007, D-023); unblocking is a schema change with its own decision entry.",
          "$ref": "common.schema.json#/$defs/verification",
          "type": "object",
          "properties": { "outcome": { "const": "blocked" } }
        }
      }
    },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  }
}
